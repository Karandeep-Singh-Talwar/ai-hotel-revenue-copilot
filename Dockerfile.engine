# ==============================================================================
# DOCKERFILE FOR AI HOTEL REVENUE INTELLIGENCE ENGINE & WORKERS
# Runs scout_scraper, event_scraper, and pricing_brain as stateless containerized workers
# ==============================================================================
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install system dependencies for Playwright headless browser and compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    wget \
    gnupg \
    cron \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir playwright xgboost lifelines psycopg2-binary scikit-learn \
    && playwright install chromium --with-deps || true

COPY engine/ ./engine/
COPY database/ ./database/

# Default entrypoint runs pricing brain cycle or cron
CMD ["python", "engine/pricing_brain.py", "--hotel-id", "1"]
